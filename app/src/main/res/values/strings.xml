    <string name="about_description">Erthi Note is an independent charitable initiative by the Erthi organisation. It provides a free, offline-first, floating notes experience for Arabic and English speakers. No advertising. No data collection. No internet connection required.</string>
    <string name="about_website">erthi.org</string>
    <string name="about_email">info@erthi.org</string>
    <string name="about_privacy_heading">Privacy</string>
    <string name="about_privacy_body">Erthi Note stores all notes locally on your device. No data is sent to any server. The application does not request internet permission. Encrypted backups are protected by a password you choose; they cannot be recovered without it.</string>
    <string name="about_licences_heading">Open-source libraries</string>
    <string name="about_licences_body">Erthi Note is built on the Android platform and uses only Android SDK and standard Java libraries. No third-party runtime libraries are included. The application source is available at github.com/Erthi-Org/Erthi-note.</string>
